
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and Test') {
            steps {
                sh 'java -version'
                sh 'mvn -B clean verify'
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Java build and tests passed!'
        }
        failure {
            echo 'FAILURE: Check the console output for details.'
        }
    }
}
